        CellPutS(SValue,'BER', vVertrieb, vProdukte, 'Jan_26', 'Ist_EUR', 'Test',vKennzahlen);
    ELSE; 
        CellPutN(NValue,'BER', vVertrieb, vProdukte, 'Jan_26', 'Ist_EUR', 'Test',vKennzahlen);  
    ENDIF;
endif;

#endregion